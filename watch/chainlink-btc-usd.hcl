# Chainlink BTC / USD feed (Ethereum)
#
# Feed proxy owner and the aggregator it points to (changes when Chainlink
# upgrades the feed), plus metadata consumers hard-code.
#
# Source: https://docs.chain.link/data-feeds/price-feeds/addresses?network=ethereum
# Contract: https://etherscan.io/address/0xF4030086522a5bEEa4988F8cA5B36dbC97BeE88c
# tags: #Chainlink #Ethereum #Oracle #Bitcoin
#
# Generated by scripts/bootstrap.py from the on-chain state.

version = "1"

chain {
  name     = "ethereum"
  chain_id = 1
  rpc      = env("RPC_URL")
}

resource "contract" "chainlinkBtcUsd" {
  address = "0xF4030086522a5bEEa4988F8cA5B36dbC97BeE88c"
  abi     = "abis/chainlink-feed-admin.abi.json"

  expect {
    aggregator  = "0x4a3411ac2948B33c69666B35cc6d055B27Ea84f1"
    decimals    = 8
    description = "BTC / USD"
    owner       = "0x21f73D42Eb58Ba49dDB685dc29D3bF5c0f0373CA"
    version     = 6
  }
}
