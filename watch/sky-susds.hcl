# Sky Savings Rate - sUSDS (Ethereum)
#
# The Sky Savings Rate (ssr, a per-second rate in ray, 1e27) paid to USDS
# savers. Set by Sky governance executive votes and adjusted every few weeks
# to months. APY = (ssr / 1e27) ^ 31536000 - 1. chi/rho are left out: they
# move on every deposit.
#
# Source: https://developers.sky.money/
# Contract: https://etherscan.io/address/0xa3931d71877C0E7a3148CB7Eb4463524FEc27fbD
# tags: #Sky #USDS #Ethereum #DeFi #Stablecoin
#
# Generated by scripts/bootstrap.py from the on-chain state.

version = "1"

chain {
  name     = "ethereum"
  chain_id = 1
  rpc      = env("RPC_URL")
}

resource "contract" "skySusds" {
  address = "0xa3931d71877C0E7a3148CB7Eb4463524FEc27fbD"
  abi     = "abis/sky-susds.abi.json"

  expect {
    ssr    = 1000000001182641576793209935
    symbol = "sUSDS"
  }
}
