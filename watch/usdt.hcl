# USDT (Ethereum)
#
# Owner, pause and deprecation flags (deprecated + upgradedAddress would
# redirect the token to a new contract), and the dormant transfer fee
# (basisPointsRate, maximumFee).
#
# Contract: https://etherscan.io/address/0xdAC17F958D2ee523a2206206994597C13D831ec7
# tags: #USDT #Tether #Ethereum #Stablecoin
#
# Generated by scripts/bootstrap.py from the on-chain state.

version = "1"

chain {
  name     = "ethereum"
  chain_id = 1
  rpc      = env("RPC_URL")
}

resource "contract" "usdt" {
  address = "0xdAC17F958D2ee523a2206206994597C13D831ec7"
  abi     = "abis/usdt.abi.json"

  expect {
    basisPointsRate = 0
    decimals        = 6
    deprecated      = false
    maximumFee      = 0
    name            = "Tether USD"
    owner           = "0xC6CDE7C39eB2f0F0095F41570af89eFC2C1Ea828"
    paused          = false
    symbol          = "USDT"
    upgradedAddress = "0x0000000000000000000000000000000000000000"
  }
}
