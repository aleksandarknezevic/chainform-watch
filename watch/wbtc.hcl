# WBTC (Ethereum)
#
# Owner of the WBTC token (the custody controller) and the pause flag.
#
# Contract: https://etherscan.io/address/0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599
# tags: #WBTC #Bitcoin #Ethereum
#
# Generated by scripts/bootstrap.py from the on-chain state.

version = "1"

chain {
  name     = "ethereum"
  chain_id = 1
  rpc      = env("RPC_URL")
}

resource "contract" "wbtc" {
  address = "0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599"
  abi     = "abis/wbtc.abi.json"

  expect {
    decimals = 8
    name     = "Wrapped BTC"
    owner    = "0xCA06411bd7a7296d7dbdd0050DFc846E95fEBEB7"
    paused   = false
    symbol   = "WBTC"
  }
}
