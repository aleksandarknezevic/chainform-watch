# Maker DAI Savings Rate - Pot (Ethereum)
#
# The DAI Savings Rate (dsr, per-second rate in ray, 1e27) behind sDAI, and
# the live flag (0 after emergency shutdown). Changed by executive spells. APY
# = (dsr / 1e27) ^ 31536000 - 1.
#
# Source: https://chainlog.sky.money/
# Contract: https://etherscan.io/address/0x197E90f9FAD81970bA7976f33CbD77088E5D7cf7
# tags: #MakerDAO #Sky #DAI #Ethereum #DeFi
#
# Generated by scripts/bootstrap.py from the on-chain state.

version = "1"

chain {
  name     = "ethereum"
  chain_id = 1
  rpc      = env("RPC_URL")
}

resource "contract" "makerPot" {
  address = "0x197E90f9FAD81970bA7976f33CbD77088E5D7cf7"
  abi     = "abis/maker-pot.abi.json"

  expect {
    dsr  = 1000000000393915525145987602
    live = 1
  }
}
