# Compound III cUSDCv3 (Ethereum)
#
# Governor, pause guardian, pause flags, number of collateral assets, and the
# interest rate curve (kinks and slopes). Rate parameters are retuned by
# governance every few weeks.
#
# Source: https://docs.compound.finance/#networks
# Contract: https://etherscan.io/address/0xc3d688B66703497DAA19211EEdff47f25384cdc3
# tags: #Compound #Ethereum #DeFi #USDC
#
# Generated by scripts/bootstrap.py from the on-chain state.

version = "1"

chain {
  name     = "ethereum"
  chain_id = 1
  rpc      = env("RPC_URL")
}

resource "contract" "compoundV3Usdc" {
  address = "0xc3d688B66703497DAA19211EEdff47f25384cdc3"
  abi     = "abis/compound-v3-comet.abi.json"

  expect {
    baseToken                            = "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"
    borrowKink                           = 900000000000000000
    borrowPerSecondInterestRateBase      = 475646879
    borrowPerSecondInterestRateSlopeHigh = 114155251141
    borrowPerSecondInterestRateSlopeLow  = 880834601
    governor                             = "0x6d903f6003cca6255D85CcA4D3B5E5146dC33925"
    isAbsorbPaused                       = false
    isBuyPaused                          = false
    isSupplyPaused                       = false
