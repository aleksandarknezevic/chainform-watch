# Chainlink ETH / USD feed (Ethereum)
#
# Feed proxy owner and the aggregator it points to (changes when Chainlink
# upgrades the feed), plus metadata consumers hard-code.
#
# Source: https://docs.chain.link/data-feeds/price-feeds/addresses?network=ethereum
# Contract: https://etherscan.io/address/0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
# tags: #Chainlink #Ethereum #Oracle
#
# Generated by scripts/bootstrap.py from the on-chain state.

version = "1"

chain {
  name     = "ethereum"
  chain_id = 1
  rpc      = env("RPC_URL")
}

resource "contract" "chainlinkEthUsd" {
  address = "0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419"
  abi     = "abis/chainlink-feed-admin.abi.json"

  expect {
    aggregator  = "0x7d4E742018fb52E48b08BE73d041C18B21de6Fb5"
    decimals    = 8
    description = "ETH / USD"
    owner       = "0x21f73D42Eb58Ba49dDB685dc29D3bF5c0f0373CA"
    version     = 6
  }
}
